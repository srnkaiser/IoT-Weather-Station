# Secrets - never commit API keys
local_settings.py

# Training data is NOT committed: 41 MB, freely available, and the download
# command is one line in the README.
data/*.csv

# Trained models are COMMITTED on purpose: they let a reviewer run
# predict_live.py immediately, without first downloading 41 MB of training
# data and waiting 15 minutes. They are 3.4 MB together and are regenerated
# by run_all.sh, so anyone who prefers to verify them can.
models/*.keras

# Test scenarios - regenerated by make_demo_scenarios.py
scenarios/

# Run logs
results/*.log

# Python
__pycache__/
*.pyc
.venv/
venv/

# macOS
.DS_Store

# IDE
.vscode/

# TensorFlow virtual environment
.venv-tf/
